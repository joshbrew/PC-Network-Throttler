<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Throttler" Width="1066" Height="669" MinWidth="760" MinHeight="576"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13" Foreground="#182B42" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#285DCA"/>
    <SolidColorBrush x:Key="Muted" Color="#516580"/>
    <SolidColorBrush x:Key="Stroke" Color="#D1DCEC"/>
    <SolidColorBrush x:Key="Surface" Color="#F3FFFFFF"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,6"/><Setter Property="MinHeight" Value="33"/>
      <Setter Property="Foreground" Value="#233E64"/><Setter Property="Background" Value="#F7FAFF"/>
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#669AE7"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#3469D4"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.78"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.48"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8,4"/><Setter Property="MinHeight" Value="32"/>
      <Setter Property="BorderBrush" Value="#C4D3E9"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="#FCFDFF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Input" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="7">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Input" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Input" Property="Opacity" Value="0.52"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="17" Height="17" CornerRadius="4" BorderBrush="#8EA5C8"
                      BorderThickness="1" Background="#FFFFFF" VerticalAlignment="Center">
                <Path x:Name="Check" Width="10" Height="8" Data="M 0,3 L 3,6 L 9,0" Stretch="Fill"
                      Stroke="#FFFFFF" StrokeThickness="1.6" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#4480E1"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.46"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Height" Value="35"/><Setter Property="Padding" Value="10,0,7,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#3C5271"/>
      <Setter Property="Background" Value="#ECF2FB"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderBrush" Value="#DCE5F1"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style TargetType="ListViewItem">
      <Setter Property="MinHeight" Value="32"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6F3FF" Offset="0"/><GradientStop Color="#F0F5FD" Offset="0.5"/>
        <GradientStop Color="#E6EAF8" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>
    <Grid Margin="23,19,23,17">
      <Grid.RowDefinitions><RowDefinition Height="69"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border CornerRadius="15" BorderBrush="#C9DAF0" BorderThickness="1" Padding="18,10">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
            <GradientStop Color="#FBFDFF" Offset="0"/><GradientStop Color="#E2EFFF" Offset="0.64"/><GradientStop Color="#DCE5FC" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Right" Padding="11,5" Background="#ECFFFFFF" BorderBrush="#CEDDF3" BorderThickness="1"
                  CornerRadius="12" VerticalAlignment="Center" MaxWidth="264" Margin="12,0,0,0">
            <TextBlock x:Name="EngineStatus" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
          </Border>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="4" Height="28" CornerRadius="2" Background="{StaticResource Accent}" Margin="0,0,13,0"/>
            <TextBlock Text="Network Throttler" VerticalAlignment="Center" FontSize="27" FontWeight="SemiBold"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Grid.Row="1" Margin="0,12,0,0" Padding="15,13" Background="{StaticResource Surface}" CornerRadius="13"
              BorderBrush="{StaticResource Stroke}" BorderThickness="1">
        <Grid x:Name="DeviceEditor">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="This PC" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <CheckBox x:Name="GlobalUploadCheck" Content="Upload" Width="83"/>
              <TextBox x:Name="GlobalUploadRate" Width="66" AutomationProperties.Name="PC upload limit in Mbps" MaxLength="5"/>
              <TextBlock Text="Mbps" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <CheckBox x:Name="GlobalDownloadCheck" Content="Download" Width="95"/>
              <TextBox x:Name="GlobalDownloadRate" Width="66" AutomationProperties.Name="PC download limit in Mbps" MaxLength="5"/>
              <TextBlock Text="Mbps" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
            </StackPanel>
            <Button x:Name="SaveGlobal" Grid.Column="2" Content="Save speeds" Style="{StaticResource Primary}"/>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Row="2" Margin="0,12,0,0" Padding="15,13" Background="{StaticResource Surface}" CornerRadius="13"
              BorderBrush="{StaticResource Stroke}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="248"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="App limits" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock x:Name="MonitorStatus" Margin="12,0,9,0" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" MaxWidth="327" Foreground="{StaticResource Muted}"/>
            </StackPanel>
            <Grid Grid.Column="1">
              <TextBox x:Name="AppSearch" AutomationProperties.Name="Search apps"/>
              <TextBlock x:Name="SearchHint" Text="Search running or saved apps" Foreground="{StaticResource Muted}"
                         Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
          </Grid>
          <Border Grid.Row="1" CornerRadius="8" BorderThickness="1" BorderBrush="#D9E3F2" Background="#FFFFFF">
            <ListView x:Name="AppList" SelectionMode="Single" BorderThickness="0" Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      AutomationProperties.Name="Running apps and saved rules">
              <ListView.View>
                <GridView AllowsColumnReorder="False">
                  <GridViewColumn Width="201" DisplayMemberBinding="{Binding Name}"><GridViewColumn.Header><GridViewColumnHeader Content="App" Tag="Name"/></GridViewColumn.Header></GridViewColumn>
                  <GridViewColumn Width="78" DisplayMemberBinding="{Binding Running}"><GridViewColumn.Header><GridViewColumnHeader Content="Running" Tag="Running"/></GridViewColumn.Header></GridViewColumn>
                  <GridViewColumn Width="130" DisplayMemberBinding="{Binding Live.UploadText}"><GridViewColumn.Header><GridViewColumnHeader Content="Upload (Mbps)" Tag="LiveUpload"/></GridViewColumn.Header></GridViewColumn>
                  <GridViewColumn Width="142" DisplayMemberBinding="{Binding Live.DownloadText}"><GridViewColumn.Header><GridViewColumnHeader Content="Download (Mbps)" Tag="LiveDownload"/></GridViewColumn.Header></GridViewColumn>
                  <GridViewColumn Width="106" DisplayMemberBinding="{Binding Upload}"><GridViewColumn.Header><GridViewColumnHeader Content="Upload limit" Tag="UploadSort"/></GridViewColumn.Header></GridViewColumn>
                  <GridViewColumn Width="116" DisplayMemberBinding="{Binding Download}"><GridViewColumn.Header><GridViewColumnHeader Content="Download limit" Tag="DownloadSort"/></GridViewColumn.Header></GridViewColumn>
                  <GridViewColumn Width="193" DisplayMemberBinding="{Binding Path}"><GridViewColumn.Header><GridViewColumnHeader Content="Executable" Tag="Path"/></GridViewColumn.Header></GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </Border>
          <TextBlock x:Name="SelectedApp" Grid.Row="2" Text="Select an app to edit its limits." TextTrimming="CharacterEllipsis"
                     Margin="0,9,0,8" Foreground="{StaticResource Muted}"/>
          <Grid x:Name="AppEditor" Grid.Row="3" IsEnabled="False">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <CheckBox x:Name="AppUploadCheck" Content="Upload" Width="83"/>
              <TextBox x:Name="AppUploadRate" Width="59" AutomationProperties.Name="App upload limit in Mbps" MaxLength="5"/>
              <TextBlock Text="Mbps" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <CheckBox x:Name="AppDownloadCheck" Content="Download" Width="95"/>
              <TextBox x:Name="AppDownloadRate" Width="59" AutomationProperties.Name="App download limit in Mbps" MaxLength="5"/>
              <TextBlock Text="Mbps" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button x:Name="SaveApp" Content="Save rule"/><Button x:Name="ClearApp" Content="Remove rule" Margin="7,0,0,0"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="True">
        <Button x:Name="CloseWindow" DockPanel.Dock="Right" Content="Close" IsCancel="True" MinWidth="75" VerticalAlignment="Center"/>
        <Button x:Name="Uninstall" DockPanel.Dock="Right" Content="Uninstall" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <StackPanel VerticalAlignment="Center" Margin="2,0,12,0">
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}">
            <Run Text="Source: "/><Hyperlink x:Name="SourceLink" Foreground="{StaticResource Accent}"
                NavigateUri="https://github.com/joshbrew/PC-Network-Throttler" AutomationProperties.Name="Open Network Throttler source on GitHub">https://github.com/joshbrew/PC-Network-Throttler</Hyperlink>
          </TextBlock>
          <TextBlock x:Name="Feedback" TextWrapping="Wrap" Margin="0,3,0,0"
                     Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
